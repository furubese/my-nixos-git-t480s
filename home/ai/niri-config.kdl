// niri設定（~/.config/niri/config.kdl として配置される）
// issue #21: 普段使いのFedora環境（niri + noctalia）に寄せた設定
// リファレンス: https://github.com/YaLTeR/niri/wiki/Configuration:-Overview

input {
    keyboard {
        xkb {
            // 日本語キーボードレイアウト
            layout "jp"
        }
    }

    touchpad {
        // タップでクリック
        tap
        // ナチュラルスクロール
        natural-scroll
    }
}

cursor {
    // catppuccin frappe greenカーソル
    // （実体は modules/ai/niri-desktop.nix で catppuccin-cursors.frappeGreen を導入）
    xcursor-theme "catppuccin-frappe-green-cursors"
    xcursor-size 32
}

layout {
    gaps 16

    focus-ring {
        active-color "#7fc8ff"
    }

    // borderは無効のまま（focus-ringで十分）
    border {
        off
    }
}

// 中クリックによるプライマリセレクション貼り付けを無効化
clipboard {
    disable-primary
}

// スクリーンショットの保存先
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// noctaliaデスクトップシェルを起動。
// 注意: noctaliaはnixpkgsに存在しないため別途導入が必要（PRの説明参照）。
// 導入まではこの行は失敗するだけで害はない。
spawn-at-startup "sh" "-c" "NOCTALIA_ASSETS_DIR=$HOME/.local/share/noctalia-assets exec noctalia"

binds {
    // ==== 基本 ====
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T { spawn "alacritty"; }
    Mod+D { spawn "fuzzel"; }
    Super+Alt+L { spawn "swaylock"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }

    // ==== フォーカス移動 ====
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // ==== カラム/ウィンドウの移動 ====
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    // ==== モニター間のフォーカス移動 ====
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    // ==== モニター間の移動 ====
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // ==== ワークスペース ====
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }

    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }
    Mod+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollUp { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ==== カラムの結合/分離 ====
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // ==== サイズ変更 ====
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-column-height "-10%"; }
    Mod+Shift+Equal { set-column-height "+10%"; }

    // ==== noctalia連携（issue #21） ====
    // ランチャーパネルのトグル
    Alt+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    // コントロールセンターのトグル
    Mod+S { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    // overviewトグル + noctaliaランチャートグル
    Super+O { spawn "sh" "-c" "niri msg action toggle-overview && noctalia msg launcher toggle"; }
    // モニターの電源オフ
    Mod+Shift+P { power-off-monitors; }

    // ==== 音量キー（wpctl / PipeWire） ====
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // ==== 輝度キー（brightnessctl） ====
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }

    // ==== メディアキー（playerctl） ====
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioPause { spawn "playerctl" "pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
}
